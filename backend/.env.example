# Dùng khi chạy API trực tiếp bằng `dotnet run` (không qua docker compose).
# Nạp bằng: set -a && source .env && set +a   (bash) hoặc dùng dotnet user-secrets.
# Với compose, cấu hình lấy từ .env ở thư mục gốc.

CONNECTIONSTRINGS__DEFAULT=Host=localhost;Port=5432;Database=incident_tracker;Username=incident;Password=doi-mat-khau-nay
JWT__SIGNINGKEY=doi-khoa-nay-toi-thieu-32-ky-tu-truoc-khi-chay
JWT__ISSUER=incident-tracker-api
JWT__AUDIENCE=incident-tracker-web
JWT__EXPIRYMINUTES=15
SEED__APPLYMIGRATIONS=true
SEED__ADMINEMAIL=admin@incident.local
SEED__ADMINPASSWORD=doi-mat-khau-admin-nay
# Bỏ trống = theo môi trường; đặt true để bật tường minh ở nơi không phải Development.
SWAGGER__ENABLED=
RATELIMIT__LOGINPERMINUTE=10
RATELIMIT__REGISTERPERHOUR=5
REGISTRATION__ENABLED=true
REGISTRATION__ALLOWEDEMAILDOMAINS=
REGISTRATION__REQUIREAPPROVAL=false
REGISTRATION__DEFAULTROLES=customer
REGISTRATION__MINPASSWORDLENGTH=8
SLA__INVESTIGATINGHOURS=24
SLA__MITIGATINGHOURS=48
SLA__SCANINTERVALMINUTES=15
# Phản hồi tự động: chèn lời xác nhận tiếp nhận vào luồng trả lời của phản hồi mới (FR-BIZ-14).
FEEDBACK__AUTOACKENABLED=true
# Bỏ trống dòng dưới để dùng nội dung mặc định trong appsettings.json.
#FEEDBACK__AUTOACKMESSAGE=
OBSERVABILITY__ENABLEPROMETHEUS=true
OBSERVABILITY__TRACESAMPLERATIO=0.1
SECURITY__REQUIREHTTPS=false
CORS__ALLOWEDORIGINS__0=http://localhost:3000
# Địa chỉ health của web để /api/health/system soi được cả ba service.
HEALTHCHECKS__WEBURL=http://localhost:3000/healthz
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080

# Chuỗi kết nối dùng cho integration test (tạo/hủy database tạm trong lúc chạy).
TEST_DB_CONNECTION=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres

# --- Nạp quyền theo request (ADR-004) ---
# Token chỉ mang danh tính; vai trò và permission đọc từ database ở mỗi request.
# 0 = luôn đọc mới, thu hồi quyền có hiệu lực tức thì (khuyến nghị).
# Đặt > 0 để giảm số truy vấn, đổi lại quyền vừa gỡ còn hiệu lực đúng chừng ấy giây.
AUTH__PERMISSIONCACHESECONDS=0
