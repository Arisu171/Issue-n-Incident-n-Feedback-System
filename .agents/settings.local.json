{
  "permissions": {
    "allow": [
      "Bash",
      "Bash(*)",
      "PowerShell",
      "PowerShell(*)",
      "mcp__next-devtools",
      "mcp__sequential-thinking",
      "mcp__figma"
    ],
    "deny": [],
    "defaultMode": "bypassPermissions"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "*"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.agents/hooks/auto-approve-mcp.mjs\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.agents/hooks/auto-approve-mcp.mjs\""
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true
}