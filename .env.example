# ---------------------------------------------------------------------------
# Cấu hình cho `docker compose up --build` ở thư mục gốc.
# Sao chép thành .env rồi đổi mọi giá trị bí mật trước khi chạy:
#     cp .env.example .env
# .env đã nằm trong .gitignore — tuyệt đối không commit (NFR-SEC-02).
# ---------------------------------------------------------------------------

# --- PostgreSQL (CNT-03) ---
POSTGRES_DB=gitissues
POSTGRES_USER=gitissue
POSTGRES_PASSWORD=doi-mat-khau-nay
DB_PORT=5432
# Trần kết nối của Npgsql. Mặc định của driver là 100, bằng đúng max_connections của
# PostgreSQL: một đợt tải cao sẽ chiếm sạch và khoá luôn cửa vào của người vận hành.
DB_MAX_POOL_SIZE=40

# PostgreSQL bên ngoài (Supabase, Neon, RDS…). Bỏ trống = dùng service `db` trong compose.
# Đây là chuỗi kết nối Npgsql dạng khoá=giá trị, KHÔNG phải URI postgres://…
# Ví dụ Supabase (session mode, cổng 5432 — không dùng 6543 vì migration cần prepared statement):
# Bọc trong nháy kép: chuỗi có dấu cách (`SSL Mode`, `Search Path`), thiếu nháy thì mọi
# script `source` tệp này đều hỏng.
#   # Pool phải lớn hơn (số consumer × TICKETING_CONSUMER_CONCURRENCY) — 6 consumer × 1 = 6, nên 15
# là dư an toàn cho cả request HTTP lẫn job nền. Đặt nhỏ hơn thì pool cạn lúc outbox xả mạnh
# và health check db timeout; app sẽ cảnh báo ngay lúc khởi động nếu bạn đặt sai.
DB_CONNECTION_STRING="Host=<host>;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<mat-khau>;SSL Mode=Require;Maximum Pool Size=15;Search Path=gitissues"
#
# `Search Path` tách toàn bộ bảng của ứng dụng ra một schema riêng thay vì đổ vào `public`.
# Trên Supabase điều đó còn có nghĩa là bảng không bị PostREST tự phơi ra API công khai.
# Schema phải TỰ TẠO TRƯỚC, EF không tạo hộ:  CREATE SCHEMA IF NOT EXISTS gitissues;
DB_CONNECTION_STRING=

# --- API (CNT-02) ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Mức log cho câu lệnh SQL của EF Core. Mặc định Warning.
# Đặt Information để soi từng câu truy vấn — hữu ích khi gỡ lỗi, nhưng lần khởi động đầu với
# dữ liệu demo sẽ in ra hàng chục nghìn dòng và mất khoảng một phút mới lắng.
SQL_LOG_LEVEL=Warning

# Khóa ký JWT — tối thiểu 32 ký tự (256 bit). Sinh khóa mới bằng:
#     openssl rand -base64 48
JWT_SIGNING_KEY=doi-khoa-nay-toi-thieu-32-ky-tu-truoc-khi-chay
JWT_ISSUER=gitissues-api
JWT_AUDIENCE=gitissues-web
# ADR-001: access token ngắn hạn, không có refresh token ở Release 1.
JWT_EXPIRY_MINUTES=15

# Swagger UI và file đặc tả OpenAPI.
# Bỏ trống = theo môi trường: bật ở Development, tắt ở nơi khác. Đây là mặc định an toàn vì
# đặc tả công khai giúp người lạ liệt kê được toàn bộ bề mặt API.
# Đặt true nếu bản triển khai của bạn là nội bộ hoặc chỉ để demo.
SWAGGER_ENABLED=

# Rate limit đăng nhập theo IP, cửa sổ 1 phút (mục 6.6).
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Rate limit đăng ký theo IP, cửa sổ 1 giờ. Siết chặt hơn đăng nhập vì một người thật chỉ
# đăng ký vài lần, còn kịch bản tự động thì tạo hàng loạt tài khoản rác.
RATE_LIMIT_REGISTER_PER_HOUR=5

# --- Tự đăng ký tài khoản (UC-08) ---
# Bật thì người dùng tự tạo được tài khoản mà không cần liên hệ quản trị viên.
REGISTRATION_ENABLED=true
# Chỉ nhận email thuộc các tên miền này, phân tách bằng dấu phẩy. Bỏ trống là nhận mọi tên
# miền — tiện cho môi trường học tập nhưng KHÔNG nên dùng khi hệ thống phơi ra Internet:
# đây mới là hàng rào thật sự ngăn người ngoài tổ chức tạo tài khoản.
REGISTRATION_ALLOWED_DOMAINS=
# Bật thì tài khoản mới bị vô hiệu hóa cho tới khi quản trị viên kích hoạt.
REGISTRATION_REQUIRE_APPROVAL=false
# Vai trò gán cho tài khoản tự đăng ký. Chỉ "customer" và "viewer" được phép — danh sách
# trắng cứng trong mã sẽ lọc bỏ mọi giá trị khác, kể cả khi đặt nhầm thành "admin".
#   customer = khách hàng tự gửi sự cố/phản hồi và chỉ thấy phần của mình (mặc định)
#   viewer   = chỉ tra cứu, không gửi được gì
REGISTRATION_DEFAULT_ROLES=customer
REGISTRATION_MIN_PASSWORD_LENGTH=8

# --- Tài khoản quản trị bootstrap ---
# Mục 5.7 cấm seed mật khẩu production. Bỏ trống SEED_ADMIN_PASSWORD thì API bỏ qua
# bước tạo admin thay vì dùng một giá trị mặc định đoán được.
SEED_ADMIN_EMAIL=admin@gitissues.local
SEED_ADMIN_PASSWORD=doi-mat-khau-admin-nay

# Tài khoản mang vai trò `system` (rank 120) — TÁCH HẲN khỏi admin.
# Chỉ vai trò này chạm được cấu hình nền: ngưỡng SLA và loại vấn đề.
# Không có mặc định trong mã nguồn: bỏ trống cả hai thì admin giữ tạm vai trò đó.
# `admin` ở rank 100 không tự gán nổi vai trò rank 120, nên tách là có hiệu lực thật.
SEED_SYSTEM_EMAIL=
SEED_SYSTEM_PASSWORD=

# Sinh dữ liệu trình diễn khi khởi động (người dùng, project, ticket, sự cố, phản hồi).
# Chỉ bật ở môi trường demo — dữ liệu giả không có chỗ trong database thật.
SEED_DEMO_DATA=false

# --- Phản hồi tự động (FR-BIZ-14) ---
# Bật thì mỗi phản hồi mới nhận ngay một lời xác nhận tiếp nhận trong luồng trả lời.
# Lời xác nhận không đổi trạng thái feedback — nó vẫn là "Mới" cho tới khi có người thật trả lời.
FEEDBACK_AUTO_ACK_ENABLED=true
# Bỏ trống để dùng nội dung mặc định; đổi để tự xưng danh doanh nghiệp của bạn.
#FEEDBACK_AUTO_ACK_MESSAGE=

# --- Ngưỡng SLA (mục 6.9) ---
# Cảnh báo khi sự cố ở Investigating quá số giờ này. Đặt SLA_SCAN_INTERVAL_MINUTES=0 để tắt job.
SLA_INVESTIGATING_HOURS=24
SLA_MITIGATING_HOURS=48
SLA_SCAN_INTERVAL_MINUTES=15

# --- Chỗ giữ sửa (bản cập nhật 1.1.0) ---
# Mở form sửa là giữ một chỗ; chừng nào còn người khác đang giữ, lần ghi kế tiếp buộc phải
# kèm If-Match đúng phiên bản. Giá trị này là thời gian một chỗ giữ sống được nếu không ai
# gia hạn — giao diện gia hạn mỗi 45 giây, nên 120 cho phép lỡ một nhịp mà chưa mất chỗ.
#
# Đặt ngắn quá thì người soạn một mô tả dài bị rơi mất chỗ giữa chừng; dài quá thì một tab đã
# tắt còn bắt người khác gửi If-Match thêm hàng phút. Nhận 30–3600; ngoài khoảng đó app dừng
# ngay lúc khởi động thay vì chạy với cấu hình sai.
EDIT_CLAIM_TTL_SECONDS=120

# --- Observability (mục 6.9) ---
# /metrics theo định dạng Prometheus; tỷ lệ lấy mẫu trace 10% theo đề xuất của mục 6.9.
OBSERVABILITY_ENABLE_PROMETHEUS=true
OBSERVABILITY_TRACE_SAMPLE_RATIO=0.1

# --- Bảo mật ---
# Mục 6.7 yêu cầu HTTPS ở production. Để false cho compose HTTP thuần của môn học;
# bật true khi triển khai sau một ingress có TLS.
SECURITY_REQUIRE_HTTPS=false

# --- Web (CNT-01) ---
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Trình duyệt gọi API qua cổng publish của host, không dùng tên service nội bộ "api".
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Nạp quyền theo request (ADR-004) ---
# Token chỉ mang danh tính; vai trò và permission đọc từ database ở mỗi request.
# 0 = luôn đọc mới, thu hồi quyền có hiệu lực tức thì (khuyến nghị).
# Đặt > 0 để giảm số truy vấn, đổi lại quyền vừa gỡ còn hiệu lực đúng chừng ấy giây.
AUTH_PERMISSION_CACHE_SECONDS=0

# --- Module Tickets — Architecture v3.1 (tái hiện GitHub Issues) ---
# Rate limit đọc/ghi theo user cho API ticket (BR-SEC-03).
TICKETING_READ_PER_MINUTE=300
TICKETING_WRITE_PER_MINUTE=100
# Thời gian giữ Idempotency-Key (giờ) và chu kỳ job bảo trì partition/dọn key (phút, 0 = tắt).
TICKETING_IDEMPOTENCY_TTL_HOURS=24
TICKETING_MAINTENANCE_INTERVAL_MINUTES=360
# Số message một consumer endpoint xử lý song song. Mỗi lượt consume giữ một connection Npgsql
# suốt transaction inbox/outbox, nên (số consumer x giá trị này) phải nhỏ hơn DB_MAX_POOL_SIZE —
# còn dư chỗ cho request HTTP, health check và job nền. Để trống/bỏ dòng này là dùng mặc định 4.
TICKETING_CONSUMER_CONCURRENCY=4
# Message broker: để trống = MassTransit in-memory (đủ cho một instance API; message chưa xử lý
# mất khi API tắt nhưng outbox trong DB sẽ phát lại). Đặt "rabbitmq" và chạy
#     docker compose --profile rabbitmq up --build
# để dùng RabbitMQ bền (nhiều instance API, DLQ *_error thấy được trên UI quản trị :15672).
TICKETING_RABBITMQ_HOST=
TICKETING_RABBITMQ_USERNAME=guest
TICKETING_RABBITMQ_PASSWORD=guest
# Webhook: mặc định chặn URL http / loopback / mạng nội bộ (chống SSRF). Bật true khi demo với receiver nội bộ.
TICKETING_WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false
TICKETING_WEBHOOKS_RETRY_SCAN_SECONDS=30
# Chu kỳ quét SLA ticket (phút, 0 = tắt).
TICKETING_SLA_SCAN_INTERVAL_MINUTES=1
# Tệp đính kèm: mặc định lưu trong volume api-storage qua presigned URL ký HMAC; tối đa 25 MB.
TICKETING_STORAGE_MAX_BYTES=26214400
# S3/MinIO tuỳ chọn — có bucket thì presigned URL trỏ thẳng object storage (BR-EV-05).
TICKETING_S3_BUCKET=
TICKETING_S3_REGION=
TICKETING_S3_SERVICE_URL=
TICKETING_S3_ACCESS_KEY=
TICKETING_S3_SECRET_KEY=
TICKETING_S3_PUBLIC_BASE_URL=
