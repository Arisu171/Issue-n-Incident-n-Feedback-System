 "item": [
  {
   "name": "1. Sức khỏe hệ thống",
   "item": [
    {
     "name": "Cả ba service — GET /api/health/system",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/health/system",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "health",
        "system"
       ]
      },
      "description": "Yêu cầu \"Có web, api, db healthy\". Một lời gọi duy nhất trả về trạng thái của cả ba service."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('HTTP 200 — toàn hệ thống khỏe', () => pm.response.to.have.status(200));",
         "",
         "const body = pm.response.json();",
         "pm.test('Trạng thái tổng là Healthy', () => pm.expect(body.status).to.eql('Healthy'));",
         "",
         "const byName = Object.fromEntries(body.checks.map((c) => [c.name, c.status]));",
         "pm.test('api healthy', () => pm.expect(byName.api).to.eql('Healthy'));",
         "pm.test('db healthy', () => pm.expect(byName.db).to.eql('Healthy'));",
         "pm.test('web healthy', () => pm.expect(byName.web).to.eql('Healthy'));",
         "",
         "pm.test('Có correlationId để đối chiếu log', () => pm.expect(body.correlationId).to.be.a('string').and.not.empty);"
        ]
       }
      }
     ]
    },
    {
     "name": "Chỉ api và db — GET /api/health",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/health",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "health"
       ]
      },
      "description": "Endpoint mà docker compose dùng làm healthcheck. Cố ý KHÔNG soi web: compose khai báo web depends_on api healthy, nên api chờ web sẽ tạo khóa chết."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
         "",
         "const names = pm.response.json().checks.map((c) => c.name);",
         "pm.test('Gồm api và db', () => { pm.expect(names).to.include('api'); pm.expect(names).to.include('db'); });",
         "pm.test('Không gồm web — tránh khóa chết khi khởi động', () => pm.expect(names).to.not.include('web'));"
        ]
       }
      }
     ]
    }
   ]
