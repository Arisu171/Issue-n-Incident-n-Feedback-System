       ]
      },
      "description": "Đặt biến adminPassword bằng giá trị SEED_ADMIN_PASSWORD trong .env trước khi chạy."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
         "",
         "const body = pm.response.json();",
         "pm.collectionVariables.set('token', body.accessToken);",
         "",
         "pm.test('Nhận được access token', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
