    {
     "name": "Đăng ký kèm roles=admin — POST /api/auth/register",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"username\": \"{{newUserLogin}}\",\n  \"displayName\": \"Người tự đăng ký\",\n  \"password\": \"Demo#12345\",\n  \"roles\": [\n    \"admin\"\n  ],\n  \"isActive\": true\n}"
      },
      "url": {
       "raw": "{{baseUrl}}/api/auth/register",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "auth",
        "register"
       ]
      },
      "description": "Thân yêu cầu cố tình kèm roles và isActive. RegisterRequest không khai báo hai trường đó nên chúng bị bỏ qua — đường công khai không cho người đăng ký tự chọn vai trò."
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const stamp = Date.now();",
         "pm.collectionVariables.set('newUserEmail', `postman-${stamp}@demo.local`);",
         "pm.collectionVariables.set('newUserLogin', `postman-${stamp}`);"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
         "const body = pm.response.json();",
         "pm.collectionVariables.set('newUserToken', body.session ? body.session.accessToken : '');",
         "",
         "pm.test('Không tự cấp được vai trò admin', () => {",
         "  pm.expect(body.roles).to.eql(['customer']);",
         "});",
         "pm.test('Được cấp phiên làm việc ngay', () => pm.expect(body.session).to.not.be.null);",
         "",
         "// Kiểm tra theo tính chất chứ không ghim danh sách: điều phải đúng là tài khoản tự",
         "// đăng ký không chạm được vào quyền quản trị hay vòng đời xử lý sự cố.",
         "const perms = body.session.permissions;",
         "pm.test('Có đúng quyền tự phục vụ', () => {",
         "  pm.expect(perms).to.include.members(['incident.create', 'incident.read', 'feedback.create']);",
         "});",
         "pm.test('Không có quyền leo thang', () => {",
         "  ['incident.update_status', 'incident.delete', 'user.manage', 'role.manage',",
         "   'project.manage', 'project.member.manage'].forEach(p =>",
         "    pm.expect(perms).to.not.include(p));",
         "});"
        ]
       }
      }
     ]
    },
