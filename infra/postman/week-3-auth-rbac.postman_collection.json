  {
   "name": "2. Phân quyền theo vai trò — 403",
   "description": "Token hợp lệ, danh tính rõ ràng, nhưng thiếu permission. Phân biệt với nhóm 1: đây là 403 (biết anh là ai, anh không được phép), không phải 401.",
   "item": [
    {
     "name": "2.1 Khách hàng đọc danh sách user → 403",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{customerAToken}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/users",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "users"
       ]
      },
      "description": "user.read là quyền quản trị."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
         "pm.test(\"Lỗi theo chuẩn ProblemDetails\", () => {",
         "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
         "});",
         "pm.test(\"Có correlationId để tra log\", () => {",
         "  pm.expect(pm.response.json().correlationId).to.be.a(\"string\");",
         "});",
         "pm.test(\"Nói rõ quyền còn thiếu\", () => pm.expect(pm.response.json().requiredPermission).to.eql(\"user.read\"));"
        ]
       }
