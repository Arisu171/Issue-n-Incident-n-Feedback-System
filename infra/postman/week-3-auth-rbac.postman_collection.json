        "{{project}}",
        "incidents",
        "{{incidentAId}}"
       ]
      },
      "description": "Cùng vai trò, cùng quyền trên giấy. Đây là ca mà kiểm tra theo vai trò không bắt được."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
