{
 "info": {
  "name": "Tuần 3 — JWT, RBAC & Hardening",
  "description": "Bộ kiểm thử cho buổi thực hành tuần 3 của Incident & Feedback Tracker.\n\nCÁCH DÙNG\n1. Đặt biến baseUrl, adminEmail, adminPassword cho khớp .env của bạn.\n2. Chạy lần lượt nhóm 0 để lấy token và tạo dữ liệu mẫu.\n3. Chạy các nhóm 1 đến 5 theo thứ tự.\n\nNhóm 1 đến 3 là kiểm thử âm — chúng chứng minh hệ thống biết TỪ CHỐI, và đó mới là toàn bộ giá trị của lớp phân quyền. Nhóm 5 là đối chứng, để phân biệt 'phân quyền đúng' với 'hỏng toàn bộ'.\n\nEmail khách hàng có hậu tố ngẫu nhiên sinh ở pre-request script, nên chạy lại nhiều lần không bị 409 trùng email. Lưu ý rate limit đăng ký mặc định 5 lần/giờ/IP.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "// Sinh email và username mới cho mỗi lần chạy để không đụng ràng buộc duy nhất.",
     "if (!pm.collectionVariables.get(\"runId\")) {",
     "  pm.collectionVariables.set(\"runId\", Date.now().toString(36));",
     "}",
     "const r = pm.collectionVariables.get(\"runId\");",
     "pm.collectionVariables.set(\"customerAEmail\", `kh-a-${r}@lab.local`);",
     "pm.collectionVariables.set(\"customerBEmail\", `kh-b-${r}@lab.local`);",
     "pm.collectionVariables.set(\"customerALogin\", `kh-a-${r}`);",
     "pm.collectionVariables.set(\"customerBLogin\", `kh-b-${r}`);"
    ]
   }
  }
 ],
 "item": [
  {
   "name": "0. Chuẩn bị — chạy đúng thứ tự một lần",
   "description": "Đăng nhập admin, tạo hai tài khoản khách hàng và một sự cố làm mục tiêu cho các ca kiểm thử âm. Chỉ cần chạy lại nhóm này khi token hết hạn (mặc định 15 phút).",
   "item": [
    {
     "name": "0.1 Đăng nhập admin",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"identifier\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
      },
      "url": {
       "raw": "{{baseUrl}}/api/auth/login",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "auth",
        "login"
       ]
      },
      "description": "Lấy token quản trị. Token lưu vào biến collection để các request sau dùng lại."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
         "const b = pm.response.json();",
         "pm.collectionVariables.set(\"adminToken\", b.accessToken);",
         "pm.test(\"Token có hạn dùng ngắn\", () => pm.expect(b.expiresInSeconds).to.be.below(3601));",
         "pm.test(\"Trả về danh sách permission\", () => pm.expect(b.permissions).to.be.an(\"array\"));",
         "console.log(\"Vai trò:\", b.roles.join(\", \"), \"| số permission:\", b.permissions.length);"
        ]
       }
      }
     ]
    },
    {
     "name": "0.2 Đăng ký khách hàng A",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{customerAEmail}}\",\n  \"username\": \"{{customerALogin}}\",\n  \"displayName\": \"Khách hàng A\",\n  \"password\": \"{{customerPassword}}\"\n}"
      },
      "url": {
       "raw": "{{baseUrl}}/api/auth/register",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "auth",
        "register"
       ]
      },
      "description": "Đường công khai. Body cố ý KHÔNG có trường roles — người đăng ký không tự chọn được vai trò."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
         "const b = pm.response.json();",
         "pm.test(\"Chỉ nhận vai trò customer\", () => pm.expect(b.roles).to.eql([\"customer\"]));",
         "pm.collectionVariables.set(\"customerAToken\", b.session.accessToken);",
         "pm.collectionVariables.set(\"customerAId\", b.userId);"
        ]
       }
      }
     ]
    },
    {
     "name": "0.3 Đăng ký khách hàng B",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{customerBEmail}}\",\n  \"username\": \"{{customerBLogin}}\",\n  \"displayName\": \"Khách hàng B\",\n  \"password\": \"{{customerPassword}}\"\n}"
      },
      "url": {
       "raw": "{{baseUrl}}/api/auth/register",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "auth",
        "register"
       ]
      },
      "description": "Cần tài khoản thứ hai thì mới chứng minh được ranh giới dữ liệu giữa hai người dùng."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
         "pm.collectionVariables.set(\"customerBToken\", pm.response.json().session.accessToken);"
        ]
       }
      }
     ]
    },
    {
     "name": "0.4 Khách hàng A tham gia project",
     "request": {
      "method": "PUT",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{customerAToken}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/project-catalog/{{project}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "project-catalog",
        "{{project}}"
       ]
      },
      "description": "Vai trò customer được cấp quyền trên project, nhưng quyền chỉ có hiệu lực khi người dùng đã tự tham gia. Khách B cố ý KHÔNG tham gia — đó là biến độc lập của nhóm 3."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
        ]
       }
      }
     ]
    },
    {
     "name": "0.5 Khách hàng A gửi sự cố",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{customerAToken}}"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"title\": \"Không đăng nhập được vào ứng dụng\",\n  \"description\": \"Bấm đăng nhập thì báo lỗi 500.\",\n  \"severity\": \"High\"\n}"
      },
      "url": {
       "raw": "{{baseUrl}}/api/projects/{{project}}/incidents",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "projects",
        "{{project}}",
        "incidents"
       ]
      },
      "description": "Sự cố này là mục tiêu cho toàn bộ nhóm 3. Ghi nhận reporter từ token, không từ body."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
         "const b = pm.response.json();",
         "pm.collectionVariables.set(\"incidentAId\", b.id);",
         "pm.test(\"Khởi tạo ở Investigating\", () => pm.expect(b.status).to.eql(\"Investigating\"));",
         "pm.test(\"Reporter lấy từ token\", () => pm.expect(b.reporter.id).to.eql(pm.collectionVariables.get(\"customerAId\")));"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "1. Xác thực — ma trận 401",
   "description": "Ba cách một request có thể thiếu danh tính hợp lệ. Cả ba phải cho 401, và thông điệp lỗi không được nói rõ hỏng ở đâu.",
   "item": [
    {
     "name": "1.1 Thiếu token → 401",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/api/projects/{{project}}/incidents",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "projects",
        "{{project}}",
        "incidents"
       ]
      },
      "description": "Không có header Authorization. Nếu ra 200 thì API đang mở hoàn toàn."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
         "pm.test(\"Lỗi theo chuẩn ProblemDetails\", () => {",
         "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
         "});",
         "pm.test(\"Có correlationId để tra log\", () => {",
         "  pm.expect(pm.response.json().correlationId).to.be.a(\"string\");",
         "});",
         "pm.test(\"Không lộ lý do cụ thể\", () => {",
         "  const d = pm.response.json().detail.toLowerCase();",
         "  pm.expect(d).to.not.include(\"signature\");",
         "  pm.expect(d).to.not.include(\"expired\");",
         "});"
        ]
       }
      }
     ]
    },
