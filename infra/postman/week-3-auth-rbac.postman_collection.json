        "exec": [
         "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
         "const h = pm.response.headers;",
         "pm.test(\"X-Content-Type-Options: nosniff\", () => pm.expect(h.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
         "pm.test(\"X-Frame-Options: DENY\", () => pm.expect(h.get(\"X-Frame-Options\")).to.eql(\"DENY\"));",
         "pm.test(\"Referrer-Policy: no-referrer\", () => pm.expect(h.get(\"Referrer-Policy\")).to.eql(\"no-referrer\"));"
        ]
